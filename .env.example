# Required: bearer token for the API (at least 16 characters). Scripts use it; it acts as an admin.
# Generate one with: openssl rand -hex 32
GOLEK_API_TOKEN=

# First admin account for the web UI, created once when the users table is empty
# (at least 12 characters). Create more users afterwards with POST /users.
GOLEK_ADMIN_USERNAME=admin
GOLEK_ADMIN_PASSWORD=

# PostgreSQL container bootstrap settings. The API's DATABASE_URL is built from these.
POSTGRES_USER=golek
# Required. Use URL-safe characters, e.g. openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=golekthreat

# Published host port for the web UI. The API and PostgreSQL are not published.
FRONTEND_PORT=3000
